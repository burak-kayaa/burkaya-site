---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { summary, experience, projects, skills, education, certifications, languages } from "../data/cv";
---

<Base title="About" description={summary}>
  <h1>{site.name}</h1>
  <p class="lede">{site.title} · {site.location}</p>
  <p>{summary}</p>
  <ul class="links">
    <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
    <li><a href={site.github}>github.com/burak-kayaa</a></li>
    <li><a href={site.linkedin}>LinkedIn</a></li>
  </ul>

  <h2>Experience</h2>
  {
    experience.map((r) => (
      <article class="role">
        <div class="when">
          {r.start} – {r.end}
        </div>
        <div>
          <h3>
            {r.title} · {r.company}
          </h3>
          <p class="meta">{r.subtitle}</p>
          <ul>
            {r.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </div>
      </article>
    ))
  }

  <h2>Projects</h2>
  <p>
    <a href="/projects#canya">Canya</a>, a local-first desktop app for technical diagrams, is the ongoing one. Academic
    and competition work:
  </p>
  {
    projects.map((p) => (
      <article class="role">
        <div class="when">{p.period}</div>
        <div>
          <h3>{p.name}</h3>
          <p class="meta">
            {p.context} · {p.stack.join(", ")}
          </p>
          <ul>
            {p.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </div>
      </article>
    ))
  }

  <h2>Skills</h2>
  <dl class="skills">
    {
      skills.map((s) => (
        <>
          <dt>{s.group}</dt>
          <dd>{s.items.join(", ")}</dd>
        </>
      ))
    }
  </dl>

  <h2>Education</h2>
  {
    education.map((e) => (
      <article class="role">
        <div class="when">{e.period}</div>
        <div>
          <h3>
            {e.degree} · {e.school}
          </h3>
          <p>{e.note}</p>
        </div>
      </article>
    ))
  }

  <h2>Certifications</h2>
  <ul>
    {
      certifications.map((c) => (
        <li>
          {c.name} — {c.issuer}, {c.date}
        </li>
      ))
    }
  </ul>

  <h2>Languages</h2>
  <p>{languages.join(" · ")}</p>
</Base>

<style>
  .role {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
    padding-top: 1.25rem;
    margin-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .role h3 {
    margin-top: 0;
    margin-bottom: 0.2em;
  }
  .role .when {
    color: var(--muted);
    font-size: 0.9rem;
    padding-top: 0.2em;
  }
  .role ul {
    padding-left: 1.1rem;
    margin-bottom: 0;
  }
  .role li + li {
    margin-top: 0.35em;
  }
  .skills {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 0.5rem 1rem;
    margin: 0;
  }
  .skills dt {
    font-weight: 600;
  }
  .skills dd {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 34rem) {
    .role,
    .skills {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
