---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Blog" description="Notes on backend systems, PostgreSQL, event-driven architecture, and building Canya.">
  <h1>Blog</h1>
  <p class="lede">Notes on backend systems, PostgreSQL, event-driven architecture, and building Canya.</p>
  <PostList posts={posts} />
  <p class="meta" style="margin-top: 1.5rem">Subscribe via <a href="/rss.xml">RSS</a>.</p>
</Base>
