---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  posts: CollectionEntry<"blog">[];
}
const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="meta">Nothing published yet.</p>
  ) : (
    <ul class="posts">
      {posts.map((p) => (
        <li>
          <FormattedDate date={p.data.date} />
          <div>
            <a href={`/blog/${p.id}`}>{p.data.title}</a>
            <p class="meta">{p.data.description}</p>
          </div>
        </li>
      ))}
    </ul>
  )
}

<style>
  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .posts li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--rule);
  }
  .posts li:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .posts a {
    font-weight: 600;
    color: var(--ink);
  }
  .posts p {
    margin: 0.2rem 0 0;
  }
  @media (max-width: 30rem) {
    .posts li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
