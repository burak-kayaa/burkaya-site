---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { canya, site } from "../data/site";
import { projects } from "../data/cv";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Canya</div>
  </div>

  <HorizontalCard
    title={canya.name}
    img="/canya.webp"
    desc={canya.tagline}
    url={canya.url}
    badge="APP"
    tags={["Tauri 2", "Rust", "React", "TypeScript", "Excalidraw"]}
    linkTags={false}
  />

  <div class="prose max-w-none mt-6 mb-10">
    <p>
      Canya is a desktop app built on Tauri 2 and React with an Excalidraw canvas underneath. You draw system diagrams,
      architecture sketches and visual docs, organise them into sessions and folders, and everything is saved as a
      versioned JSON file (<code>.canya</code>) on your own disk.
    </p>
    <p>
      It is deliberately offline: no account system, no backend, no cloud storage, no telemetry. The one exception is
      <em>Import from Link</em> — a single, user-initiated fetch of an <code>https://</code> project file, validated with
      the same schema used to open a local file.
    </p>
    <ul>
      <li>Bundled icon catalog: Simple Icons, Devicon, and the official AWS, Azure and Google Cloud icon sets.</li>
      <li>Twelve built-in block libraries from the excalidraw-libraries collection.</li>
      <li>Native app bar, session tabs, folders, autosave and close protection.</li>
      <li>Signed releases with an in-app updater; installs for {canya.platforms.join(", ")}.</li>
    </ul>
    <p>
      <a class="btn btn-primary no-underline" href={canya.url} target="_blank">Download Canya</a>
      <a class="btn btn-outline no-underline ml-3" href={canya.releases} target="_blank">Releases</a>
      <a class="btn btn-ghost no-underline ml-3" href={`${canya.repo}/issues`} target="_blank">Report an issue</a>
    </p>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Work</div>
  </div>

  <HorizontalCard
    title="VistaLine — B2B quotation & pricing platform"
    desc="Dealer self-service quoting with a rule-based pricing engine over 22 product families, live FX rates, RBAC across dealer and admin roles, a full quote lifecycle, and three audience-specific PDF outputs from one shared quote model."
    url="/cv"
    target="_self"
    badge="2026"
    tags={["FastAPI", "PostgreSQL", "Docker", "Railway"]}
    linkTags={false}
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Bear Analytica — multi-tenant phishing-simulation SaaS"
    desc="20+ tenants, 5M+ tracking events a month, ~50K requests a day at p95 under 200 ms. Tenant isolation, indexing work that cut report queries by ~60%, RAG pipelines and agentic workflows for report generation and triage."
    url="/cv"
    target="_self"
    badge="2024–2026"
    tags={["Spring Boot", "PostgreSQL", "Keycloak", "NATS", "LangChain"]}
    linkTags={false}
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Academic & competition</div>
  </div>

  {
    projects.map((p, i) => (
      <>
        {i > 0 && <div class="divider my-0" />}
        <HorizontalCard
          title={p.name}
          desc={`${p.context}. ${p.bullets[0]}`}
          url="/cv"
          target="_self"
          badge={p.period}
          tags={p.stack}
          linkTags={false}
        />
      </>
    ))
  }

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Open source & older work</div>
  </div>
  <p>
    École 42 projects (cub3d, push_swap, Philosophers, minitalk, ft_printf), ML coursework and a TeknoFest unmanned
    underwater systems entry are all on <a class="link" href={site.github} target="_blank">GitHub</a>.
  </p>
</BaseLayout>
