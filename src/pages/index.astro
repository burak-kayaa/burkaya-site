---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";
import { site, canya } from "../data/site";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm {site.name}</div>
    <div class="text-3xl py-3 font-bold">{site.title}</div>
    <div class="py-2">
      <text class="text-lg">
        I build secure, scalable SaaS backends in <b>Java/Spring Boot</b> and <b>Python/FastAPI</b> — from API design
        and PostgreSQL modelling to event-driven pipelines and production operations. Lately that includes putting RAG
        and agentic workflows into real products. On the side I make <b>Canya</b>, a local-first desktop app for
        technical diagrams.
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href={`mailto:${site.email}`} target="_blank"> Let's connect!</a>
      <a href="/cv" class="btn btn-outline ml-5"> Read my CV </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">My projects {"</>"}</div>
  </div>

  <HorizontalCard
    title={canya.name}
    img="/canya.webp"
    desc={`${canya.tagline} Runs on ${canya.platforms.join(", ")}; every project is a plain file on your disk and the app makes no network requests.`}
    url={canya.url}
    badge="APP"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="VistaLine — B2B quotation platform"
    desc="FastAPI backend with a rule-based pricing engine across 22 product families, dealer self-service quoting, RBAC, and three PDF outputs generated from one quote model."
    url="/projects"
    target="_self"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Multi-tenant phishing-simulation SaaS"
    desc="Spring Boot platform serving 20+ tenants and ~50K requests/day; tenant isolation, PostgreSQL tuning, RAG pipelines and agentic workflows."
    url="/projects"
    target="_self"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Latest from blog</div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
